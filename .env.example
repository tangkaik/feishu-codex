FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace-with-your-app-secret
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_OWNER_USER_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 中文：留空表示转发 FEISHU_CHAT_ID 中 FEISHU_OWNER_USER_ID 发来的所有消息。
# English: Leave empty to forward every message from FEISHU_OWNER_USER_ID in FEISHU_CHAT_ID.
FEISHU_CODEX_PREFIX=
FEISHU_CODEX_REQUIRE_PREFIX=false

# 中文：每次轮询读取的最近消息数量。飞书 API 当前最多 50。
# English: Number of recent messages to read on each poll. Feishu API currently supports up to 50.
FEISHU_POLL_PAGE_SIZE=50
